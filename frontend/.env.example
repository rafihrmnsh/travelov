# Base URL the SPA uses to reach the API.
#
# Leave this EMPTY (or omit the file entirely) to use same-origin requests,
# which is the default for both supported setups:
#   - Docker image: nginx serves the SPA and proxies /api and /health to the api container.
#   - Vite dev server: proxies /api and /health to http://localhost:5080.
VITE_API_BASE_URL=

# Alternatively, point the SPA straight at the API origin, e.g.:
# VITE_API_BASE_URL=http://localhost:5080
